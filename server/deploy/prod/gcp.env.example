# 11a.6 GCP deploy vars — template. Copy to gcp.env (gitignored via *.env) and fill.
#   cp server/deploy/prod/gcp.env.example server/deploy/prod/gcp.env
#   source server/deploy/prod/gcp.env        # once per shell
# See RUNBOOK.md for the full deploy sequence.

# Self-deriving from active gcloud config (gcloud config set project/run/region).
export PROJECT_ID="$(gcloud config get-value project 2>/dev/null)"
export REGION="$(gcloud config get-value run/region 2>/dev/null)"
export REGION="${REGION:-asia-south1}"

# Runtime service account for Cloud Run (created in step 0).
export RUN_SA="identity-run@${PROJECT_ID}.iam.gserviceaccount.com"

# Resource names (stable; edit if you rename).
export SQL_INSTANCE="identity-pg"
export SQL_DB="identity"
export SQL_USER="identity"
export KMS_KEYRING="identity"
export KMS_KEY="jwt-signing"
export AR_REPO="identity"
export RUN_SERVICE="identity"

# ── Fill these as you go (secrets — never commit the real gcp.env) ──────────────
# DB password (openssl rand -base64 24 in step 2).
export SQL_PASSWORD=""
# Cloud SQL connection name = PROJECT:REGION:INSTANCE (step 2 describe output).
export CONN_NAME=""
# Full KMS CryptoKeyVersion resource name (step 3 describe output).
export JWT_KMS_KEY_NAME=""
# Built image ref (step 5).
export IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/identity:latest"

echo "gcp.env loaded: project=${PROJECT_ID} region=${REGION} run_sa=${RUN_SA}"

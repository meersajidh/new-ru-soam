# ── Server ────────────────────────────────────────────────────────────────────
# TCP port to listen on. Cloud Run injects $PORT automatically.
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pipe-separated list of allowed origins. Dev default: localhost.
# Set to the Electron app origin (app://) for prod once wired (11a.5).
CORS_ALLOWED_ORIGINS=http://localhost:3000|http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO
# Log format: json | text  (default: json; use text for local readability)
LOG_FORMAT=json

# ── Google ID-token verification (11a.1) ──────────────────────────────────────
# Desktop-app OAuth2 client ID used as the audience when verifying Google ID
# tokens.  The Desktop Main process does the OAuth code-exchange and ships only
# the ID token here (ADR-311 §3, node-first invariant).
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# If unset at startup the service logs a WARN; real tokens will be rejected.
GOOGLE_CLIENT_ID=<your-google-oauth2-client-id>

# ── Postgres / account store (11a.2) ─────────────────────────────────────────
# pgx-compatible Postgres connection string.
# For local dev: start Postgres via `just db-identity-up` (docker compose).
# If unset: service starts but /health/ready → 503 and POST /v1/session → 500.
DATABASE_URL=postgres://identity:identity@localhost:5432/identity?sslmode=disable

# ── JWT signing / token issuance (11a.3) ─────────────────────────────────────
#
# Key load order: JWT_SIGNING_KEY_PEM (inline) → JWT_SIGNING_KEY_PATH (file)
#                 → JWT_DEV_EPHEMERAL=true (ephemeral, WARN) → hard fail at boot.
#
# For local dev, set JWT_DEV_EPHEMERAL=true.  Tokens issued with an ephemeral
# key are invalid across restarts.  Do NOT use in production.
JWT_DEV_EPHEMERAL=true

# For production: generate a 2048-bit RSA keypair and provide the private key.
#   openssl genrsa -out identity.pem 2048
#   openssl rsa -in identity.pem -pubout -out identity.pub.pem
#
# Option A — inline PEM (Cloud Run / Secret Manager env var):
# JWT_SIGNING_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
#
# Option B — file path:
# JWT_SIGNING_KEY_PATH=/secrets/identity.pem

# Option C — Cloud KMS (production, 11a.6):
# Mutually exclusive with the PEM options above.  When JWT_KMS_KEY_NAME is set,
# JWT_SIGNING_KEY_PEM, JWT_SIGNING_KEY_PATH, and JWT_DEV_EPHEMERAL are ignored.
#
# Provide a full CryptoKeyVersion resource name.  The key algorithm must be
# RSA_SIGN_PKCS1_2048_SHA256 (RS256).  The Cloud Run service account requires
# the "Cloud KMS CryptoKey Signer/Verifier" IAM role on the key.
#
#   JWT_KMS_KEY_NAME=projects/PROJECT/locations/asia-south1/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/1
#
# JWT_ISSUER sets the "iss" claim (default: ru-soam-identity).
# JWT_ISSUER=ru-soam-identity

# Access token lifetime, time.ParseDuration format (default: 15m).
# JWT_ACCESS_TTL=15m

# Refresh token lifetime (default: 720h = 30 days).
# JWT_REFRESH_TTL=720h

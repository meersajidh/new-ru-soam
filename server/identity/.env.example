# ── Server ────────────────────────────────────────────────────────────────────
# TCP port to listen on. Cloud Run injects $PORT automatically.
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pipe-separated list of allowed origins. Dev default: localhost.
# Set to the Electron app origin (app://) for prod once wired (11a.5).
CORS_ALLOWED_ORIGINS=http://localhost:3000|http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO
# Log format: json | text  (default: json; use text for local readability)
LOG_FORMAT=json

# ── Google ID-token verification (11a.1) ──────────────────────────────────────
# Desktop-app OAuth2 client ID used as the audience when verifying Google ID
# tokens.  The Desktop Main process does the OAuth code-exchange and ships only
# the ID token here (ADR-311 §3, node-first invariant).
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# If unset at startup the service logs a WARN; real tokens will be rejected.
GOOGLE_CLIENT_ID=<your-google-oauth2-client-id>

# ── Postgres / account store (11a.2) ─────────────────────────────────────────
# pgx-compatible Postgres connection string.
# For local dev: start Postgres via `just db-identity-up` (docker compose).
# If unset: service starts but /health/ready → 503 and POST /v1/session → 500.
DATABASE_URL=postgres://identity:identity@localhost:5432/identity?sslmode=disable

# ── Added in later slices ─────────────────────────────────────────────────────
# 11a.3: JWT_SIGNING_KEY_PEM=<path or secret name>

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port to listen on. Cloud Run injects $PORT automatically.
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pipe-separated list of allowed origins. Dev default: localhost.
# Set to the Electron app origin (app://) for prod once wired (11a.5).
CORS_ALLOWED_ORIGINS=http://localhost:3000|http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO
# Log format: json | text  (default: json; use text for local readability)
LOG_FORMAT=json

# ── Added in later slices ─────────────────────────────────────────────────────
# 11a.1: GOOGLE_CLIENT_ID=<oauth2-client-id>
# 11a.3: JWT_SIGNING_KEY_PEM=<path or secret name>
# 11a.4: DB_DSN=postgres://user:pass@host/db?sslmode=require

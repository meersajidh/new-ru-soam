# Cloudflare Pages — security & cache headers
#
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
# Apply long cache to fingerprinted assets; everything else gets a short TTL
# plus the standard hardening headers.
#
# script-src hash: sha256-+aLLBW9KGuc+jf0G7h/xhbqaod4GS8JawuaxtI6ely0=
# This hash covers the inline theme-flip <script> block that is byte-identical
# across index.html, download.html, and changelog.html.
# If the theme script changes, recompute:
#   python3 -c "
#     import hashlib, base64, re
#     s = re.search(r'<script>(.*?)</script>',
#       open('apps/web/templates/download.html').read(), re.DOTALL).group(1)
#     print('sha256-' + base64.b64encode(hashlib.sha256(s.encode()).digest()).decode())
#   "

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'sha256-+aLLBW9KGuc+jf0G7h/xhbqaod4GS8JawuaxtI6ely0='; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# HTML — revalidate on every request, never stale
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Long-lived assets (fingerprinted CSS / images / icons)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

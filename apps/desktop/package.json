{
  "name": "ru-soam",
  "version": "0.1.10",
  "description": "ru-soam practitioner desktop workbench app",
  "homepage": "https://ru-soam.com",
  "author": {
    "email": "meersajidh@gmail.com",
    "name": "meer"
  },
  "private": true,
  "license": "private",
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "tsr generate && tsc -b && vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.fp-host.config.ts && node scripts/build-views.mjs",
    "build:views": "node scripts/build-views.mjs",
    "dev": "tsr generate && node scripts/dev.mjs",
    "dist": "pnpm run build && node scripts/build-changelog.mjs && electron-builder --config electron-builder.yml",
    "dist:install": "node scripts/install-launcher.mjs",
    "dist:uninstall": "node scripts/uninstall-launcher.mjs",
    "compile": "tsr generate && tsc -b",
    "lint": "eslint .",
    "postinstall": "node scripts/rebuild-natives.mjs",
    "route-gen": "tsr generate",
    "test": "node --experimental-strip-types --experimental-loader=./scripts/test-loader.mjs --test electron/main/store/backup.test.ts electron/main/store/schema-gate.test.ts"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@electron/rebuild": "^4.0.4",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:router",
    "@tanstack/router-cli": "catalog:router",
    "@tanstack/router-devtools": "catalog:router",
    "@tanstack/router-plugin": "catalog:router",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "electron": "41.7.1",
    "electron-builder": "^26.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@basebench/ui": "workspace:*",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@node-rs/argon2": "^2.0.2",
    "@ru-soam/domain": "workspace:*",
    "@ru-soam/editor": "workspace:*",
    "@scure/bip39": "^2.2.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.9.0",
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "electron-updater": "^6.8.9"
  }
}

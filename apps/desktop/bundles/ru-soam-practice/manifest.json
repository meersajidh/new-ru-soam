{
  "id": "ru-soam-practice",
  "version": "0.1.0",
  "entry": "index.mjs",
  "activationEvents": ["lazy"],
  "capabilities": [
    { "name": "record.patient.query", "version": "1.0", "phi": true, "kind": "query" },
    { "name": "record.patient", "version": "1.0", "phi": true, "kind": "command" }
  ],
  "views": [
    { "id": "roster", "path": "roster.html" },
    { "id": "form", "path": "form.html" },
    { "id": "overview", "path": "overview.html" },
    { "id": "aspects", "path": "aspects.html" },
    { "id": "projections", "path": "projections.html" }
  ],
  "contributes": {
    "activityBar.items": [
      {
        "id": "ru-soam-practice.activity",
        "label": "Practice",
        "icon": "files",
        "viewContainer": "ru-soam-practice.container",
        "group": "top",
        "when": "workspace.activeId"
      }
    ],
    "viewContainers": [
      {
        "id": "ru-soam-practice.container",
        "title": "Practice",
        "view": "roster",
        "location": "primary"
      },
      {
        "id": "ru-soam-practice.context",
        "title": "Client",
        "view": "aspects",
        "location": "auxiliary",
        "when": "patient.activeId"
      }
    ],
    "panel.views": [
      {
        "id": "ru-soam-practice.notes",
        "title": "Notes",
        "icon": "file-text",
        "view": "projections",
        "when": "patient.activeId",
        "priority": 100
      }
    ],
    "menus": {
      "ru-soam-practice/roster/context": [
        { "command": "ru-soam-practice.roster.setActive",   "group": "1_status@1" },
        { "command": "ru-soam-practice.roster.setInactive", "group": "1_status@2" },
        { "command": "ru-soam-practice.roster.archive",     "group": "9_danger@1" },
        { "title": "Set Stage", "submenu": "ru-soam-practice/stage/submenu", "group": "2_stage@1" }
      ],
      "ru-soam-practice/stage/submenu": [
        { "command": "ru-soam-practice.lifecycle.setReferral",   "group": "1_stage@1" },
        { "command": "ru-soam-practice.lifecycle.setIntake",     "group": "1_stage@2" },
        { "command": "ru-soam-practice.lifecycle.setActive",     "group": "1_stage@3" },
        { "command": "ru-soam-practice.lifecycle.setOnHold",     "group": "1_stage@4" },
        { "command": "ru-soam-practice.lifecycle.setDischarged", "group": "1_stage@5" }
      ],
      "ru-soam-practice/intake/context": [
        { "command": "ru-soam-practice.lifecycle.setReferral",   "group": "1_stage@1" },
        { "command": "ru-soam-practice.lifecycle.setIntake",     "group": "1_stage@2" },
        { "command": "ru-soam-practice.lifecycle.setActive",     "group": "1_stage@3" },
        { "command": "ru-soam-practice.lifecycle.setOnHold",     "group": "1_stage@4" },
        { "command": "ru-soam-practice.lifecycle.setDischarged", "group": "1_stage@5" }
      ]
    }
  }
}

{
  "id": "ru-soam-practice",
  "version": "0.1.0",
  "entry": "index.mjs",
  "activationEvents": ["lazy"],
  "capabilities": [],
  "views": [
    { "id": "roster", "path": "roster.html" },
    { "id": "form", "path": "form.html" },
    { "id": "overview", "path": "overview.html" },
    { "id": "aspects", "path": "aspects.html" },
    { "id": "projections", "path": "projections.html" }
  ],
  "contributes": {
    "activityBar.items": [
      {
        "id": "ru-soam-practice.activity",
        "label": "Practice",
        "icon": "users",
        "viewContainer": "ru-soam-practice.container",
        "group": "top",
        "when": "workspace.activeId"
      }
    ],
    "viewContainers": [
      {
        "id": "ru-soam-practice.container",
        "title": "Practice",
        "view": "roster",
        "location": "primary"
      },
      {
        "id": "ru-soam-practice.context",
        "title": "Client",
        "view": "aspects",
        "location": "auxiliary",
        "when": "patient.activeId"
      }
    ],
    "panel.views": [
      {
        "id": "ru-soam-practice.notes",
        "title": "Notes",
        "icon": "file-text",
        "view": "projections",
        "when": "patient.activeId",
        "priority": 100
      }
    ]
  }
}

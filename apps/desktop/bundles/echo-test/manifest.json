{
  "id": "echo-test",
  "version": "0.1.0",
  "entry": "index.mjs",
  "activationEvents": ["eager"],
  "capabilities": [
    { "name": "echo.ping", "version": "1.0" }
  ],
  "views": [
    { "id": "main", "path": "echo-view.html" },
    { "id": "react-smoke", "path": "react-smoke.html", "runtime": "react" }
  ],
  "contributes": {
    "commands": [
      { "id": "echo-test.hello", "title": "Echo: Hello from Host" }
    ],
    "menus": {
      "editor/title/context": [
        { "command": "echo-test.hello", "group": "9_test@1" }
      ]
    },
    "keybindings": [
      { "key": "ctrl+alt+h", "command": "echo-test.hello", "args": ["from keybinding"] }
    ]
  }
}

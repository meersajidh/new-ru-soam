{
  "name": "ru-soam-monorepo",
  "version": "0.1.7",
  "description": "ru-soam mono-repo",
  "author": {
    "name": "meer",
    "email": "meersajidh@gmail.com"
  },
  "private": true,
  "license": "private",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:public": "node scripts/check-public.mjs",
    "check:all": "pnpm --filter ru-soam compile && pnpm --filter ru-soam lint && pnpm run check:public",
    "prepare": "husky"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
